CREATE USER SA PASSWORD DIGEST 'd41d8cd98f00b204e9800998ecf8427e'
ALTER USER SA SET LOCAL TRUE
CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE MEMORY TABLE PUBLIC.ASISTENTES(APELLIDO VARCHAR(255) NOT NULL,FECHA_NACIMIENTO DATE NOT NULL,ID_USUARIO BIGINT NOT NULL PRIMARY KEY,NOMBRE_INSTITUCION VARCHAR(255))
CREATE MEMORY TABLE PUBLIC.EDICIONES_ARCHIVADAS(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,CIUDAD VARCHAR(255) NOT NULL,FECHA_ARCHIVO DATE NOT NULL,FECHA_CREACION DATE NOT NULL,FECHA_FIN DATE NOT NULL,FECHA_INICIO DATE NOT NULL,NOMBRE VARCHAR(255) NOT NULL,NOMBRE_EVENTO VARCHAR(255) NOT NULL,PAIS VARCHAR(255) NOT NULL,SIGLA VARCHAR(255) NOT NULL,ID_ORGANIZADOR BIGINT,CONSTRAINT UNQ_EDICIONES_ARCHIVADAS_6 UNIQUE(NOMBRE))
ALTER TABLE PUBLIC.EDICIONES_ARCHIVADAS ALTER COLUMN ID RESTART WITH 5
CREATE MEMORY TABLE PUBLIC.ORGANIZADORES(DESCRIPCION VARCHAR(255) NOT NULL,ID_USUARIO BIGINT NOT NULL PRIMARY KEY,SITIO_WEB VARCHAR(255))
CREATE MEMORY TABLE PUBLIC.REGISTROS(CODIGO_PATROCINIO VARCHAR(255),COSTO DOUBLE NOT NULL,FECHA_REGISTRO DATE NOT NULL,NOMBRE_TIPO_REGISTRO VARCHAR(255) NOT NULL,USO_PATROCINIO BOOLEAN NOT NULL,ID_ASISTENTE BIGINT NOT NULL,ID_EDICION BIGINT NOT NULL,PRIMARY KEY(ID_ASISTENTE,ID_EDICION),CONSTRAINT FK_REGISTROS_ID_ASISTENTE FOREIGN KEY(ID_ASISTENTE) REFERENCES PUBLIC.ASISTENTES(ID_USUARIO),CONSTRAINT FK_REGISTROS_ID_EDICION FOREIGN KEY(ID_EDICION) REFERENCES PUBLIC.EDICIONES_ARCHIVADAS(ID))
CREATE MEMORY TABLE PUBLIC.USUARIOS(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,EMAIL VARCHAR(255) NOT NULL,NICKNAME VARCHAR(255) NOT NULL,NOMBRE VARCHAR(255) NOT NULL,TIPOUSUARIO VARCHAR(255) NOT NULL,CONSTRAINT UNQ_USUARIOS_1 UNIQUE(EMAIL),CONSTRAINT UNQ_USUARIOS_2 UNIQUE(NICKNAME))
ALTER TABLE PUBLIC.USUARIOS ALTER COLUMN ID RESTART WITH 7
ALTER TABLE PUBLIC.ASISTENTES ADD CONSTRAINT FK_ASISTENTES_ID_USUARIO FOREIGN KEY(ID_USUARIO) REFERENCES PUBLIC.USUARIOS(ID)
ALTER TABLE PUBLIC.EDICIONES_ARCHIVADAS ADD CONSTRAINT FK_EDICIONES_ARCHIVADAS_ID_ORGANIZADOR FOREIGN KEY(ID_ORGANIZADOR) REFERENCES PUBLIC.ORGANIZADORES(ID_USUARIO)
ALTER TABLE PUBLIC.ORGANIZADORES ADD CONSTRAINT FK_ORGANIZADORES_ID_USUARIO FOREIGN KEY(ID_USUARIO) REFERENCES PUBLIC.USUARIOS(ID)
ALTER SEQUENCE SYSTEM_LOBS.LOB_ID RESTART WITH 1
SET DATABASE DEFAULT INITIAL SCHEMA PUBLIC
GRANT USAGE ON DOMAIN INFORMATION_SCHEMA.CARDINAL_NUMBER TO PUBLIC
GRANT USAGE ON DOMAIN INFORMATION_SCHEMA.YES_OR_NO TO PUBLIC
GRANT USAGE ON DOMAIN INFORMATION_SCHEMA.CHARACTER_DATA TO PUBLIC
GRANT USAGE ON DOMAIN INFORMATION_SCHEMA.SQL_IDENTIFIER TO PUBLIC
GRANT USAGE ON DOMAIN INFORMATION_SCHEMA.TIME_STAMP TO PUBLIC
GRANT DBA TO SA
SET SCHEMA SYSTEM_LOBS
