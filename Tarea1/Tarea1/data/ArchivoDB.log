/*C2*/SET SCHEMA PUBLIC
CREATE TABLE asistentes (APELLIDO VARCHAR(255) NOT NULL, fecha_nacimiento DATE NOT NULL, id_usuario BIGINT NOT NULL, nombre_institucion VARCHAR(255), PRIMARY KEY (id_usuario))
CREATE TABLE ediciones_archivadas (ID BIGINT GENERATED BY DEFAULT AS IDENTITY (START WITH 1 INCREMENT BY 1) NOT NULL, CIUDAD VARCHAR(255) NOT NULL, fecha_archivo DATE NOT NULL, fecha_creacion DATE NOT NULL, fecha_fin DATE NOT NULL, fecha_inicio DATE NOT NULL, NOMBRE VARCHAR(255) NOT NULL, nombre_evento VARCHAR(255) NOT NULL, PAIS VARCHAR(255) NOT NULL, SIGLA VARCHAR(255) NOT NULL, id_organizador BIGINT, PRIMARY KEY (ID))
CREATE TABLE organizadores (DESCRIPCION VARCHAR(255) NOT NULL, id_usuario BIGINT NOT NULL, sitio_web VARCHAR(255), PRIMARY KEY (id_usuario))
CREATE TABLE registros (codigo_patrocinio VARCHAR(255), COSTO REAL NOT NULL, fecha_registro DATE NOT NULL, nombre_tipo_registro VARCHAR(255) NOT NULL, uso_patrocinio BOOLEAN NOT NULL, id_asistente BIGINT NOT NULL, id_edicion BIGINT NOT NULL, PRIMARY KEY (id_asistente, id_edicion))
CREATE TABLE usuarios (ID BIGINT GENERATED BY DEFAULT AS IDENTITY (START WITH 1 INCREMENT BY 1) NOT NULL, EMAIL VARCHAR(255) NOT NULL, NICKNAME VARCHAR(255) NOT NULL, NOMBRE VARCHAR(255) NOT NULL, TIPOUSUARIO VARCHAR(255) NOT NULL, PRIMARY KEY (ID))
ALTER TABLE ediciones_archivadas ADD CONSTRAINT UNQ_ediciones_archivadas_6 UNIQUE (NOMBRE)
ALTER TABLE usuarios ADD CONSTRAINT UNQ_usuarios_1 UNIQUE (EMAIL)
ALTER TABLE usuarios ADD CONSTRAINT UNQ_usuarios_2 UNIQUE (NICKNAME)
ALTER TABLE asistentes ADD CONSTRAINT FK_asistentes_id_usuario FOREIGN KEY (id_usuario) REFERENCES usuarios (ID)
ALTER TABLE ediciones_archivadas ADD CONSTRAINT FK_ediciones_archivadas_id_organizador FOREIGN KEY (id_organizador) REFERENCES organizadores (id_usuario)
ALTER TABLE organizadores ADD CONSTRAINT FK_organizadores_id_usuario FOREIGN KEY (id_usuario) REFERENCES usuarios (ID)
ALTER TABLE registros ADD CONSTRAINT FK_registros_id_asistente FOREIGN KEY (id_asistente) REFERENCES asistentes (id_usuario)
ALTER TABLE registros ADD CONSTRAINT FK_registros_id_edicion FOREIGN KEY (id_edicion) REFERENCES ediciones_archivadas (ID)
