<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>tprog24</groupId>
    <artifactId>Tarea2</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>war</packaging>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
    	<!-- Tarea 1 -->
    	<dependency>
    		<groupId>tpgr24Tarea1</groupId>
			<artifactId>tpgr24Tarea1</artifactId>
			<version>0.0.1-SNAPSHOT</version>
    	</dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.0.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet.jsp</groupId>
            <artifactId>jakarta.servlet.jsp-api</artifactId>
            <version>3.0.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
		    <groupId>com.opencsv</groupId>
		    <artifactId>opencsv</artifactId>
		    <version>5.9</version>
		</dependency>
		<!-- Tarea 3 -->
	    <dependency>
	        <groupId>jakarta.xml.ws</groupId>
	        <artifactId>jakarta.xml.ws-api</artifactId>
	    		<version>4.0.0</version>
		</dependency>
	    <dependency>
	        <groupId>com.sun.xml.ws</groupId>
	        <artifactId>jaxws-rt</artifactId>
	        <version>4.0.0</version>
	        <scope>runtime</scope>
		</dependency>
    </dependencies>

    <build>
    		<finalName>Tarea2</finalName>
    		<plugins>
		    <plugin>
			    <groupId>com.sun.xml.ws</groupId>
			    <artifactId>jaxws-maven-plugin</artifactId>
			    <version>4.0.0</version>
			    <executions>
			        <execution>
			            <goals>
			                <goal>wsimport</goal>
			            </goals>
			        </execution>
			    </executions>
			    <configuration> 
			        <wsdlUrls>
			            <wsdlUrl>http://localhost:4230/publicador?wsdl</wsdlUrl>
			        </wsdlUrls>
			        <keep>true</keep>
			        <sourceDestDir>src/main/java/</sourceDestDir>
			        <packageName>com.eventosuy.servidor</packageName>
			        <vmArgs>
			            <vmArg>-Djavax.xml.accessExternalSchema=all</vmArg>
			        </vmArgs>
			        <args>
			            <arg>-extension</arg>
			            <arg>-Xdebug</arg>
			        </args>
			    </configuration>
			</plugin>
    		</plugins>
    </build>
</project>
